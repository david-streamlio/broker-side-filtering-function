# Never commit local config / secrets
.env
# .env.generated is written by infra/terraform/recreate.sh (cluster URLs + SA principal)
.env.generated
license.env

# Token files dropped to disk by infra/terraform/recreate.sh during cloud-mode
# bring-up. The terraform .gitignore already covers infra/terraform/*.token;
# this one is a belt-and-suspenders for any token that drifts up to demo/.
*.token

# Pre-downloaded NARs for local-mode (large binaries, fetched per-run via
# `gh release download`). The directory is kept via local/nars/.gitkeep.
local/nars/*.nar
