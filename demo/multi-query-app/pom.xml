<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.streamnative</groupId>
        <artifactId>selector-filter-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>selector-filter-demo-multi-query</artifactId>
    <packaging>jar</packaging>
    <name>Selector Filter — Multi-Query Demo App</name>
    <description>
        Demo app that registers a configurable set of stock-quote selector queries
        through the Kafka SDK. Pair with shadowtraffic/stock-quotes.json (the
        source-side load generator) and broker-side-filter-observability (the UI)
        to showcase the full filter pipeline.
    </description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <jackson.databind.version>2.18.2</jackson.databind.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.streamnative</groupId>
            <artifactId>selector-filter-client-kafka</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Pulsar client implementation. The SDK modules declare these at
             test scope, so they aren't on the demo's runtime classpath via
             the transitive graph. Without them, PulsarClient.builder() throws
             ClassNotFoundException for PulsarClientImplementationBindingImpl. -->
        <dependency>
            <groupId>org.apache.pulsar</groupId>
            <artifactId>pulsar-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.pulsar</groupId>
            <artifactId>pulsar-client-admin</artifactId>
        </dependency>

        <!-- Kafka client for the consumer side via the SDK. -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
        </dependency>

        <!-- Read the queries.yaml. Jackson's YAML module reuses the same ObjectMapper
             we already depend on transitively through pulsar-client. -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>${jackson.databind.version}</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.13</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>multi-query-demo</finalName>
        <plugins>
            <!-- Always rebuild the thin project jar before shade runs. Without this, a second
                 `package` over the same target/ (the integration-tests CI job runs `mvn package`
                 then `mvn verify`, which re-runs `package`, with no `clean` between) finds the
                 prior run's *shaded* fat jar already "up to date", skips rebuilding it, and shade
                 then re-shades its own output — yielding spurious "overlapping classes" warnings
                 (e.g. commons-codec vs multi-query-demo.jar). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <forceCreation>true</forceCreation>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.streamnative.filter.demo.MultiQueryDemo</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Signatures: invalid once classes are repackaged. -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- Per-jar build metadata that collides across every
                                             dependency; the uber jar needs none of it. Dropping
                                             these removes the bulk of the harmless overlap noise.
                                             The final manifest is still produced by the
                                             ManifestResourceTransformer above. -->
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/maven/**</exclude>
                                        <!-- JPMS descriptors are meaningless on the flat classpath
                                             of an uber jar and overlap across modular deps. -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
