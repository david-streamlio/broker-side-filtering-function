<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.streamnative</groupId>
        <artifactId>selector-filter-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>selector-filter-perf</artifactId>
    <packaging>jar</packaging>
    <name>Selector Filter — Performance Harness</name>
    <description>
        Performance / load test harness driving the selector filter under sustained synthetic load.
        Disabled by default; enable with `-Pperf` at the reactor root. Requires a ShadowTraffic
        license supplied via SHADOWTRAFFIC_LICENSE_* environment variables.
    </description>

    <properties>
        <!--
          Perf ITs are wall-time expensive (minutes per scenario) and depend on a ShadowTraffic
          license. Both surefire and failsafe are off by default; the `perf` profile flips
          skipITs back on so the suite runs only when explicitly requested.
        -->
        <skipTests>false</skipTests>
        <skipITs>true</skipITs>
        <hdrhistogram.version>2.2.2</hdrhistogram.version>
        <!-- Internal load harness; not a consumable artifact. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- TEST scope only — perf module has no main/. -->
        <dependency>
            <groupId>io.streamnative</groupId>
            <artifactId>selector-filter-common</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.streamnative</groupId>
            <artifactId>selector-filter-client</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Reactor-ordering deps: ensure the function NARs are built before the perf module
          attempts to load them from disk. The artifacts ride into the test classpath as
          .nar archives — harmless, since the harness loads them via filesystem paths.
        -->
        <dependency>
            <groupId>io.streamnative</groupId>
            <artifactId>selector-filter-function</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.streamnative</groupId>
            <artifactId>selector-filter-orchestrator</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.pulsar</groupId>
            <artifactId>pulsar-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.pulsar</groupId>
            <artifactId>pulsar-client-admin</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hdrhistogram</groupId>
            <artifactId>HdrHistogram</artifactId>
            <version>${hdrhistogram.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>pulsar</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!--
                      Pick up both *IT and *Bench class names. Benchmark classes use the Bench
                      suffix per the plan (FilterThroughputBench, SelectorScalingBench,
                      OrchestratorHeartbeatBench); without this they would be silently skipped.
                    -->
                    <includes>
                        <include>**/*IT.java</include>
                        <include>**/*Bench.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>perf</id>
            <properties>
                <skipITs>false</skipITs>
            </properties>
        </profile>
    </profiles>
</project>
