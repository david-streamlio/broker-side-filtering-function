# Copy to .env and fill in. The docker-compose stack reads these to point the
# multi-query demo at an existing Pulsar / KoP / orchestrator deployment.
#
# `recreate.sh` writes this file automatically from terraform outputs — copying
# this template manually is only needed if you're pointing at a cluster you
# didn't provision with the demo's terraform.
#
# ShadowTraffic licensing is handled separately — see license.env.example.
# Copy that to license.env (it's gitignored) and the compose stack mounts it
# into the shadowtraffic container via `env_file:`.

# ── Pulsar / KoP cluster ────────────────────────────────────────────────────
PULSAR_SERVICE_URL=pulsar+ssl://pc-<id>.<region>.snio.cloud:6651
PULSAR_ADMIN_URL=https://pc-<id>.<region>.snio.cloud
KAFKA_BOOTSTRAP=pc-<id>.<region>.snio.cloud:9093

# ── Auth ────────────────────────────────────────────────────────────────────
# Per-demo SDK identity — each demo has its own SA so access can be audited
# and revoked independently. The orchestrator-function SA runs the control
# plane and isn't surfaced here (only docker-compose for the demo clients
# needs SDK creds; the orchestrator pod gets its token from function-mesh).
#
# Each SA has three forms of the same identity:
#   *_KAFKA_USERNAME    — bare SA name used as SASL/PLAIN username over KoP
#   *_DEMO_SA_PRINCIPAL — same SA, but as the Pulsar role string with
#                          @<org-auth> suffix that namespace permission grants
#                          look up
#   *_PULSAR_TOKEN_PATH — absolute path on the host to the SA's JWT token file
#                          (mounted into each container at
#                          /var/run/secrets/pulsar.token)

# Stock demo (docker-compose.yml) — reads the bare names below
KAFKA_USERNAME=stock-demo-app
DEMO_SA_PRINCIPAL=stock-demo-app@o-<your-org>.auth.streamnative.cloud
PULSAR_TOKEN_PATH=/absolute/path/to/demo/infra/terraform/app.token

# Parcels demo (docker-compose.parcels.yml) — reads the PARCEL_* names below
PARCEL_KAFKA_USERNAME=parcel-demo-app
PARCEL_DEMO_SA_PRINCIPAL=parcel-demo-app@o-<your-org>.auth.streamnative.cloud
PARCEL_PULSAR_TOKEN_PATH=/absolute/path/to/demo/infra/terraform/parcel-app.token

# Observability container — needs the orchestrator-function token (the SDK
# tokens above lack read access to the locked-down control-plane tenant).
# Both docker-compose.yml and docker-compose.parcels.yml mount this same token.
ORCHESTRATOR_PULSAR_TOKEN_PATH=/absolute/path/to/demo/infra/terraform/orchestrator-function.token

# ── Source topics (consistent DEMO_SOURCE_TOPIC_<scenario> naming) ───────────
# Each compose file reads only the vars for its scenario; the rest are ignored.
# All sources live in public/default per KoP's default kafkaNamespace setting.
#
# Stock-quotes scenario (docker-compose.yml) — single source topic:
DEMO_SOURCE_TOPIC_STOCKS=persistent://public/default/stock-quotes
#
# Logistics / parcels scenario (docker-compose.parcels.yml) — three source
# topics; bootstrap.sh joins them into DEMO_SOURCE_TOPICS (comma-separated) and
# dedupes namespaces. Default to public/default; override to relocate onto
# another tenant/namespace.
DEMO_SOURCE_TOPIC_SHIPMENTS=persistent://public/default/parcel-shipments
DEMO_SOURCE_TOPIC_SCANS=persistent://public/default/parcel-scans
DEMO_SOURCE_TOPIC_EXCEPTIONS=persistent://public/default/parcel-exceptions

# ── Control plane (shared by both scenarios) ─────────────────────────────────
# The orchestrator function + its filter-requests + orchestrator-state topics
# live in control-plane/broker-filter — a dedicated locked-down tenant where
# the orchestrator-function SA is the only tenant admin. Stock-demo-app and
# parcel-demo-app each get an explicit per-topic produce+consume grant on
# filter-requests so the SDK can publish REGISTER/MODIFY/UNREGISTER records,
# but they have no other access to control-plane/broker-filter.
DEMO_CONTROL_TOPIC=persistent://control-plane/broker-filter/filter-requests
DEMO_SOURCE_PARTITIONS=1
STATE_TOPIC=persistent://control-plane/broker-filter/orchestrator-state
ORCHESTRATOR_TENANT=control-plane
ORCHESTRATOR_NAMESPACE=broker-filter
ORCHESTRATOR_FUNCTION=orchestrator
HEARTBEAT_MAX_STALE_SECONDS=90

# ── Component versions (optional — pinned to the v1.1.0 GA) ─────────────────
# The combined demo pins the filtering NARs/orchestrator and the observability UI
# image to known-good releases. Override either to run a different version.
#   SELECTOR_REL           — broker-side-filtering-function release (NARs + orchestrator)
#   OBSERVABILITY_IMAGE_TAG — ghcr.io/david-streamlio/broker-side-filter-observability tag
SELECTOR_REL=v1.1.0
OBSERVABILITY_IMAGE_TAG=0.1.2

# ── ShadowTraffic license ───────────────────────────────────────────────────
# Lives in license.env (gitignored). See license.env.example for the shape.
