# Local Terraform state + provider binaries — not for version control.
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.backup
crash.log
crash.*.log

# Per-environment vars — operators copy terraform.tfvars.example to terraform.tfvars
# and fill in their own values.
terraform.tfvars
*.auto.tfvars
*.auto.tfvars.json
