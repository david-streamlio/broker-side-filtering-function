# Copy to .env and fill in. The docker-compose stack reads these to point the
# multi-query demo at an existing Pulsar / KoP / orchestrator deployment.

# ── Pulsar / KoP cluster ────────────────────────────────────────────────────
PULSAR_SERVICE_URL=pulsar+ssl://pc-<id>.<region>.snio.cloud:6651
PULSAR_ADMIN_URL=https://pc-<id>.<region>.snio.cloud
KAFKA_BOOTSTRAP=pc-<id>.<region>.snio.cloud:9093

# ── Auth ────────────────────────────────────────────────────────────────────
# SA name and absolute path to the SA's JWT token file on the host. The compose
# stack mounts the token at /var/run/secrets/pulsar.token inside each container.
KAFKA_USERNAME=tradewise-demo-tradewise-backend
PULSAR_TOKEN_PATH=/Users/you/secrets/tradewise-backend.token

# ── Topics + orchestrator location ──────────────────────────────────────────
DEMO_SOURCE_TOPIC=persistent://public/default/stock-quotes
DEMO_CONTROL_TOPIC=persistent://public/default/filter-requests
STATE_TOPIC=persistent://public/default/orchestrator-state
ORCHESTRATOR_TENANT=public
ORCHESTRATOR_NAMESPACE=default
ORCHESTRATOR_FUNCTION=orchestrator
HEARTBEAT_MAX_STALE_SECONDS=90

# ── ShadowTraffic license ───────────────────────────────────────────────────
SHADOWTRAFFIC_LICENSE_ID=
SHADOWTRAFFIC_LICENSE_KEY=
