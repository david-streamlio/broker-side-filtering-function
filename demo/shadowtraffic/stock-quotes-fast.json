{
  "generators": [
    {
      "topic": "${topic}",
      "vars": {
        "exchange": { "_gen": "oneOf", "choices": ["NYSE", "NASDAQ"] },
        "sector":   { "_gen": "oneOf", "choices": ["tech", "finance", "healthcare", "consumer", "energy", "industrial"] },
        "price":    { "_gen": "uniformDistribution", "bounds": [50.0, 500.0] },
        "bid":      { "_gen": "uniformDistribution", "bounds": [49.99, 499.95] },
        "ask":      { "_gen": "uniformDistribution", "bounds": [50.01, 500.05] },
        "bidSize":  { "_gen": "weightedOneOf", "choices": [
                        { "weight": 60, "value": 100 },
                        { "weight": 30, "value": 500 },
                        { "weight":  8, "value": 1000 },
                        { "weight":  2, "value": 5000 }
                      ] },
        "askSize":  { "_gen": "weightedOneOf", "choices": [
                        { "weight": 60, "value": 100 },
                        { "weight": 30, "value": 500 },
                        { "weight":  8, "value": 1000 },
                        { "weight":  2, "value": 5000 }
                      ] },
        "spread":   { "_gen": "uniformDistribution", "bounds": [0.01, 0.50] },
        "volume":   { "_gen": "uniformDistribution", "bounds": [100000, 50000000] },
        "side":     { "_gen": "oneOf", "choices": ["B", "S"] }
      },
      "key": {
        "_gen": "oneOf",
        "choices": [
          "AAPL", "MSFT", "GOOGL", "AMZN", "META", "NVDA", "TSLA", "AMD", "ADBE", "INTC",
          "JPM", "BAC", "WFC", "C", "GS", "MS", "V", "MA", "AXP", "BLK",
          "JNJ", "PFE", "MRK", "UNH", "ABT", "TMO", "LLY", "ABBV",
          "WMT", "HD", "NKE", "MCD", "KO", "SBUX", "PEP", "COST",
          "XOM", "CVX", "COP",
          "BA", "CAT", "GE", "HON"
        ]
      },
      "value": {
        "seq":      { "_gen": "sequentialInteger" },
        "exchange": { "_gen": "var", "var": "exchange" },
        "sector":   { "_gen": "var", "var": "sector" },
        "price":    { "_gen": "var", "var": "price" },
        "bid":      { "_gen": "var", "var": "bid" },
        "ask":      { "_gen": "var", "var": "ask" },
        "bidSize":  { "_gen": "var", "var": "bidSize" },
        "askSize":  { "_gen": "var", "var": "askSize" },
        "spread":   { "_gen": "var", "var": "spread" },
        "volume":   { "_gen": "var", "var": "volume" },
        "side":     { "_gen": "var", "var": "side" }
      },
      "headers": [
        { "key": "exchange", "value": { "_gen": "var", "var": "exchange" } },
        { "key": "sector",   "value": { "_gen": "var", "var": "sector" } },
        { "key": "side",     "value": { "_gen": "var", "var": "side" } }
      ],
      "localConfigs": {
        "throttleMs": 1
      }
    }
  ],
  "connections": {
    "kafka": {
      "kind": "kafka",
      "producerConfigs": {
        "bootstrap.servers": "${bootstrap}",
        "key.serializer":   "org.apache.kafka.common.serialization.StringSerializer",
        "value.serializer": "io.shadowtraffic.kafka.serdes.JsonSerializer",
        "security.protocol": "SASL_SSL",
        "sasl.mechanism":    "PLAIN",
        "sasl.jaas.config":  "org.apache.kafka.common.security.plain.PlainLoginModule required username=\"${username}\" password=\"token:${kafka_token}\";",
        "enable.idempotence": "false",
        "acks": "1",
        "metadata.max.age.ms": "30000"
      }
    }
  }
}
